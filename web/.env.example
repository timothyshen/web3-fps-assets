# ---- Chain selection ----------------------------------------------------
# The single source of chain truth is src/config/chain.ts.
# monadTestnet (chainId 10143, native MON)  |  anvil (chainId 31337, local)
VITE_CHAIN=monadTestnet

# Override the default RPC for the selected chain.
# Defaults: https://testnet-rpc.monad.xyz (monadTestnet) / http://127.0.0.1:8545 (anvil)
# VITE_RPC_URL=https://testnet-rpc.monad.xyz

# ---- Contract addresses -------------------------------------------------
# Paste the `forge script script/Deploy.s.sol` output here.
# A public/deployments.json file (see public/deployments.example.json)
# OVERRIDES these values without a rebuild being strictly wrong — but note
# env vars are inlined at build time, deployments.json is read at runtime.
VITE_ADDR_GAME_ASSET_REGISTRY=
VITE_ADDR_WEAPON_SKIN=
VITE_ADDR_REWARD_DISTRIBUTOR=
VITE_ADDR_SKIN_MARKET=
VITE_ADDR_MATCH_ATTESTATION=
VITE_ADDR_TOURNAMENT_ESCROW=

# ---- Asset backend ------------------------------------------------------
# Base URL of the (not yet built) asset backend that serves the web-facing
# bind endpoints. See web/README.md "Assumed backend contract".
VITE_API_BASE_URL=http://localhost:8787

# 1 = fake the bind API entirely in the browser (no backend needed).
# The mock still verifies the real SIWE signature locally.
VITE_MOCK_API=1

# ---- Optional: Privy embedded wallets -----------------------------------
# When set, the app offers email / Google / wallet login via Privy and
# creates an embedded wallet for users without one. When unset, the app
# runs with injected (browser extension) wallets only.
# VITE_PRIVY_APP_ID=

# ---- Optional: Multicall3 override --------------------------------------
# monadTestnet already has the canonical Multicall3 configured. Set this to
# enable batched reads on a chain that lacks it (e.g. an anvil fork).
# Without it, reads fall back to individual eth_call requests.
# VITE_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
