{
  "name": "web3-fps-asset-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asset backend for the web3-fps-assets skin-NFT layer (hackathon demo). Implements api/openapi.yaml plus the two web-facing bind endpoints.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:unit": "vitest run test/unit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "viem": "^2.33.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
