# ---------------------------------------------------------------------------
# Asset backend configuration (local anvil demo defaults).
# No real secrets here — anvil's default keys are PUBLICLY KNOWN test keys.
# ---------------------------------------------------------------------------

PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# ---- chain ----------------------------------------------------------------
# Local anvil (default). For Monad testnet use:
#   RPC_URL=https://testnet-rpc.monad.xyz  CHAIN_ID=10143
#   CHAIN_NAME="Monad Testnet"  NATIVE_SYMBOL=MON
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_NAME="Anvil (local)"
NATIVE_SYMBOL=ETH
NATIVE_DECIMALS=18
IS_TESTNET=true
EXPLORER_BASE_URL=https://testnet.monadexplorer.com
# Set on chains that have Multicall3 (Monad testnet: 0xcA11bde05977b3631167028862bE2a173976CA11)
#MULTICALL3_ADDRESS=

# ---- contract addresses ---------------------------------------------------
# Either set the six ADDR_* vars, or point DEPLOYMENTS_FILE at the JSON that
# scripts/deploy-local.sh writes ({ chainId, contracts: {...} }, same shape
# the web app uses). Env vars win over the file.
DEPLOYMENTS_FILE=deployments.local.json
#ADDR_GAME_ASSET_REGISTRY=
#ADDR_WEAPON_SKIN=
#ADDR_REWARD_DISTRIBUTOR=
#ADDR_SKIN_MARKET=
#ADDR_MATCH_ATTESTATION=
#ADDR_TOURNAMENT_ESCROW=

# ---- keys / secrets -------------------------------------------------------
# Anvil default account #0 (publicly known test key — NEVER use on a real
# network). Needs OPERATOR_ROLE on RewardDistributor and ATTESTER_ROLE on
# MatchAttestation; the Deploy script grants both to the deployer/admin.
# Production: KMS-held key, per docs/security.md T8.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Signs the demo-only /v1/auth/login JWTs.
JWT_SECRET=dev-only-jwt-secret-change-me

# Bearer token the game server uses for /internal/v1/* (never the player JWT).
INTERNAL_SERVICE_TOKEN=dev-internal-service-token

# ---- web app --------------------------------------------------------------
# bindUrl = {WEB_ORIGIN}/bind/{sessionId}; tournament actionUrls also point here.
WEB_ORIGIN=http://localhost:5173
# Extra hosts accepted as SIWE `domain` besides WEB_ORIGIN's host (comma-separated).
WEB_EXTRA_BIND_DOMAINS=
#MARKETPLACE_URL=

# ---- behavior -------------------------------------------------------------
ASSETS_CACHE_TTL_SECONDS=20
BIND_SESSION_TTL_SECONDS=900
REWARD_EXPIRY_DAYS=30
DEFAULT_SEASON_ID=1
ATTEST_INTERVAL_MS=2000
ATTEST_MAX_ATTEMPTS=5
BUNDLE_BASE_URL=https://cdn.example.com/bundles
DB_PATH=data/backend.sqlite3
